{
  "manifest_version": 3,
  "name": "VocabVault Extension",
  "version": "1.0",
  "description": "Lookup words and save them to your vocabulary history directly from any webpage.",
  "permissions": ["sidePanel", "activeTab", "scripting", "contextMenus", "identity"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open VocabVault"
  },
  "oauth2": {
    "client_id": "481494691712-gd5kgsiatqtki0dc66q5fadmbt9vr419.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}
